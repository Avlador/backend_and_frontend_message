generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  password String 
  createAt DateTime @default(now())
  messages Message[]
  chats Member[]
}





model Chat {
  id Int @id @default(autoincrement())
  createAt DateTime @default(now())
  messages Message[]
  members Member[]
}

model Member{
id Int @id @default(autoincrement())
userId Int
chatId Int

user User @relation(fields: [userId], references: [id])
chat Chat @relation(fields: [chatId],references: [id])

@@unique([userId, chatId]) //!эта строка создает уникальный индек, она гарантирует,
//! что в бд  не будет дубликатов данных chatId и userId
}

model Message {
  id Int @id @default(autoincrement())
  text String
  createAt DateTime @default(now())
  chatId Int
  chat Chat  @relation(fields: [chatId], references: [id])
  authorId Int
  author User @relation(fields: [authorId], references: [id])
}